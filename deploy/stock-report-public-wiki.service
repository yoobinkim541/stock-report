[Unit]
Description=Verified full-body wiki compilation and multi-source topic accumulation (8/run, 240/KST day)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/stock-report
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WIKI_SOURCE_PIPELINE_ENABLED=1
Environment=WIKI_SOURCE_ALLOW_PRIVATE=1
Environment=AGENT_CONSOLE_PUBLIC_TOPIC_BOOTSTRAP_ENABLED=1
Environment=WIKI_SOURCE_DAILY_LIMIT=240
Environment=WIKI_SOURCE_SCAN_DAYS=7
Environment=WIKI_STRUCTURED_PROVIDERS=agy,codex,openrouter,hermes
Environment=WIKI_PROVIDER_TIMEOUT=240
Environment=WIKI_STRUCTURED_DEADLINE=600
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/stock-report/.venv/bin/python -m scripts.run_public_wiki_rollout --apply --source-limit 8
TimeoutStartSec=90min
MemoryMax=3G
MemorySwapMax=0
UMask=0077

