[Unit]
Description=SaveTicker private source collection and human-confirmed recovery

[Service]
Type=oneshot
WorkingDirectory=%h/projects/stock-report
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/projects/stock-report/.venv/bin/python scripts/saveticker_recovery_tick.py --limit 1
TimeoutStartSec=240
UMask=0077
