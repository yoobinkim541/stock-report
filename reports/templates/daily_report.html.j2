<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src file:">
<title>Daily Investment Brief {{ m.date }}</title>
<style>
{% include "daily_report.css" %}
</style>
</head>
<body>
{%- set n = namespace(fig=0, tbl=0, sec=0) -%}
{%- macro chg(v, digits=2) -%}
  {%- if v is none -%}<span class="flat">–</span>
  {%- else -%}<span class="{{ v | tone }}">{{ v | pct(digits) }}</span>{%- endif -%}
{%- endmacro -%}
{%- macro heat(v, scale=5.0) -%}
  {%- if v is none -%}<td class="flat">–</td>
  {%- else -%}<td class="heat {{ v | tone }}" style="background: {{ v | heat(scale) }}">{{ v | pct(1) }}</td>{%- endif -%}
{%- endmacro -%}
{%- macro figure(src, title, source="Yahoo Finance, 자체 계산") -%}
  {%- if src -%}{%- set n.fig = n.fig + 1 -%}
  <figure><div class="cap"><b>그림 {{ n.fig }}</b>{{ title }}</div><img src="{{ src }}" alt="{{ title }}"><div class="src">자료: {{ source }}</div></figure>
  {%- endif -%}
{%- endmacro -%}
{%- macro tcap(title) -%}{%- set n.tbl = n.tbl + 1 -%}<div class="cap"><b>표 {{ n.tbl }}</b>{{ title }}</div>{%- endmacro -%}
{%- macro sec(title, english) -%}{%- set n.sec = n.sec + 1 -%}
  <h2 class="sec"><span class="no">{{ "%02d" | format(n.sec) }}</span>{{ title }}<small>{{ english }}</small></h2>
{%- endmacro -%}
{%- macro scan(rows, title) -%}
  {%- if rows -%}
  <div class="tbl">{{ tcap(title) }}
    <table><thead><tr><th class="l">종목</th><th>점수</th><th class="c">등급</th><th class="c">신호</th><th class="l">판단</th></tr></thead><tbody>
    {%- for r in rows %}
      <tr><td class="name">{{ r.ticker }}<small>{{ r.name | truncate(20, true, "…") }}</small></td><td class="strong">{{ r.score | num(0) }}</td><td class="c">{{ r.grade }}</td>
      <td class="c"><span class="badge line {{ r.tone }}">{{ r.signal_label }}</span></td><td class="l">{{ r.action }}</td></tr>
    {%- endfor %}
    </tbody></table>
  </div>
  {%- endif -%}
{%- endmacro %}

{#- ───────────── 1. 표지·요약 ───────────── #}
<section class="page cover">
  <header class="masthead">
    <div class="brand"><small>PORTFOLIO STRATEGY</small>DAILY INVESTMENT BRIEF</div>
    <div class="mast-meta"><b>{{ m.date_label }}</b>통합 데일리 투자 리포트</div>
  </header>
  <div class="title-block">
    <div class="kicker">오늘의 결론</div>
    <h1>{{ m.headline }}</h1>
    {% if m.conclusion %}<ul class="deck">{% for c in m.conclusion[:3] %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% if m.kpis %}
  <div class="kpis">
    {% for k in m.kpis %}
    <div class="kpi"><div class="l">{{ k.label }}</div>
      {% if k.unit == "%" %}<div class="v {{ k.value | tone }}">{{ k.value | pct(2) }}</div><div class="c flat">전일 대비</div>
      {% else %}<div class="v">{{ k.value | money(k.unit) }}</div><div class="c">{{ chg(k.change) }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="cols">
    <div class="main">
      {% if m.glance %}<h3>핵심 요약</h3><ul class="pts">{% for g in m.glance[:4] %}<li>{{ g }}</li>{% endfor %}</ul>{% endif %}
      {% if m.priorities | length > 1 %}
      <h3>실행 우선순위</h3>
      <div class="tbl">{{ tcap("오늘 확인할 종목과 액션") }}
        <table><thead><tr>{% for h in m.priorities[0] %}<th class="l">{{ h }}</th>{% endfor %}</tr></thead><tbody>
        {% for row in m.priorities[1:6] %}<tr>{% for cell in row %}<td class="{{ 'wrap' if loop.last else 'name' if loop.index == 2 else 'l nowrap' }}">{{ cell }}</td>{% endfor %}</tr>{% endfor %}
        </tbody></table>
        <div class="src">자료: 자체 규칙 기반 판단(Decision v2) · 비중·실적 일정 반영</div>
      </div>
      {% endif %}
    </div>
    <aside class="side">
      <h3>Key Data</h3>
      <table class="kv">
        {% if m.portfolio.value_usd %}<tr><td>평가액</td><td>${{ m.portfolio.value_usd | num(0) }}</td></tr>{% endif %}
        {% if m.portfolio.total_krw %}<tr><td>원화 환산</td><td>{{ m.portfolio.total_krw | num(0) }}원</td></tr>{% endif %}
        {% if m.portfolio.pnl_pct is not none %}<tr><td>평가손익</td><td>{{ chg(m.portfolio.pnl_pct) }}</td></tr>{% endif %}
        {% if m.portfolio.weighted_d1 is not none %}<tr><td>1일 (비중 가중)</td><td>{{ chg(m.portfolio.weighted_d1) }}</td></tr>{% endif %}
        <tr><td>보유 종목</td><td>{{ m.portfolio.holdings | length }}개</td></tr>
        {% if m.portfolio.avg_score is not none %}<tr><td>평균 재무 점수</td><td>{{ m.portfolio.avg_score | num(1) }} / 100</td></tr>{% endif %}
        {% if m.portfolio.phase %}<tr><td>바벨 Phase</td><td>{{ m.portfolio.phase }}</td></tr>{% endif %}
        {% if m.portfolio.drawdown_pct is not none %}<tr><td>QQQ 고점 대비</td><td>{{ chg(m.portfolio.drawdown_pct, 1) }}</td></tr>{% endif %}
      </table>
      {% set sc = m.portfolio.signal_counts %}{% set total = m.portfolio.holdings | length %}
      {% if total %}
      <h3>신호 분포</h3>
      <div class="stack">{% for key in ("pos", "neu", "warn", "neg") %}{% if sc[key] %}<i class="{{ key }}" style="width: {{ sc[key] / total * 100 }}%"></i>{% endif %}{% endfor %}</div>
      <div class="legend">
        <span><i class="dot pos"></i>긍정 <b>{{ sc.pos }}</b></span><span><i class="dot neu"></i>중립 <b>{{ sc.neu }}</b></span>
        <span><i class="dot warn"></i>경고 <b>{{ sc.warn }}</b></span><span><i class="dot neg"></i>심각 <b>{{ sc.neg }}</b></span>
      </div>
      {% endif %}
      {% if m.risk_flags %}<h3>주요 위험 신호</h3><ul class="pts small">{% for r in m.risk_flags[:4] %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
      {% if m.fx %}<h3>환전 타이밍</h3><ul class="pts small">{% for r in m.fx[:3] %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
    </aside>
  </div>
  {% if f.relative or f.equity %}
  <div class="grid2 cover-figs">
    <div>{{ figure(f.relative, "현재 보유 비중 바스켓 vs 벤치마크 (최근 3개월, 시작=100)", "Yahoo Finance, 자체 계산 · 현재 비중을 과거에 고정한 값으로 실제 계좌 수익률과 다름") }}</div>
    <div>{{ figure(f.equity, "포트폴리오 평가액 추이 (USD, 입출금 포함)", "포트폴리오 히스토리(자체 기록)") }}</div>
  </div>
  {% endif %}
</section>

{#- ───────────── 2. 시장 ───────────── #}
<section class="page">
  {{ sec("시장 동향", "Market") }}
  <div class="grid2 lead">
    <div>{% if m.market.summary %}<ul class="pts">{% for s in m.market.summary[:3] %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}</div>
    <div>
      {% if m.market.fear_greed %}
      <div class="gauge"><i style="left: {{ m.market.fear_greed.value }}%"></i><b style="left: {{ [[m.market.fear_greed.value, 14] | max, 86] | min }}%">공포·탐욕 {{ m.market.fear_greed.value }} · {{ m.market.fear_greed.label }}</b></div>
      <div class="scale"><span>극단적 공포</span><span>중립</span><span>극단적 탐욕</span></div>
      {% endif %}
    </div>
  </div>
  {% if m.market.indices %}
  <div class="tbl">{{ tcap("주요 지수·자산 수익률") }}
    <table><thead><tr><th class="l">자산</th><th>종가</th><th>1D</th><th>5D</th><th>1M</th><th>3M</th><th>YTD</th><th class="c">52주 범위</th><th>RSI(14)</th></tr></thead><tbody>
    {% for r in m.market.indices %}
      <tr><td class="name">{{ r.label }}</td><td class="strong">{{ r.last | money(r.unit) }}</td>
      {{ heat(r.d1, 3) }}{{ heat(r.d5, 6) }}{{ heat(r.m1, 12) }}{{ heat(r.m3, 20) }}{{ heat(r.ytd, 30) }}
      <td class="c">{% if r.pos52 is not none %}<span class="range"><i style="left: {{ r.pos52 }}%"></i></span>{% else %}–{% endif %}</td>
      <td>{{ r.rsi | num(1) }}</td></tr>
    {% endfor %}
    </tbody></table>
    <div class="src">자료: Yahoo Finance · 수정주가 기준 · 52주 범위는 저가(좌)~고가(우) 안에서 현재가 위치</div>
  </div>
  {% endif %}
  <div class="grid2">
    <div>{{ figure(f.spy, "S&P 500 (SPY) 6개월 — 종가·이동평균·거래량") }}</div>
    <div>{{ figure(f.qqq, "NASDAQ 100 (QQQ) 6개월 — 종가·이동평균·거래량") }}</div>
  </div>
  <div class="grid2">
    <div class="half">
      {{ figure(f.sectors, "섹터 ETF 1일 등락률") }}
      {% if m.market.technical %}
      <div class="tbl">{{ tcap("추세 위치") }}
        <table><thead><tr><th class="l">지표</th><th>SPY</th><th>QQQ</th></tr></thead><tbody>
        {% for t in m.market.technical %}
          <tr><td class="l">{{ t.label }}</td>
          {% for v in (t.spy, t.qqq) %}<td>{% if t.kind == "pct" %}{{ chg(v, 1) }}{% else %}{{ v | num(1) }}{% endif %}</td>{% endfor %}</tr>
        {% endfor %}
        </tbody></table>
        <div class="src">자료: Yahoo Finance, 자체 계산 · 이동평균은 종가 단순평균</div>
      </div>
      {% endif %}
    </div>
    <div class="half">
      {% if m.market.calendar %}
      <div class="tbl">{{ tcap("경제 일정 (오늘·향후 7일)") }}
        <table><thead><tr><th class="l">일자</th><th class="l">시각</th><th class="l">이벤트</th><th class="c">중요도</th></tr></thead><tbody>
        {% for e in m.market.calendar[:8] %}
          <tr><td class="l nowrap">{% if e.group == "오늘" %}<b>{{ e.date }}</b>{% else %}{{ e.date }}{% endif %}</td>
          <td class="l">{{ e.time }}</td><td class="wrap">{{ e.event }}</td><td class="c imp">{{ "★" * e.importance }}</td></tr>
        {% endfor %}
        </tbody></table>
        <div class="src">자료: 경제 캘린더(시장 리포트 수록분) · 굵은 일자는 오늘</div>
      </div>
      {% endif %}
      {% if m.market.news %}
      <h3>주요 뉴스</h3>
      <ul class="pts small">{% for item in m.market.news[:3] %}<li>{{ item.title | truncate(84, false, "…") }}{% if item.source %} <span class="flat">— {{ item.source }}</span>{% endif %}</li>{% endfor %}</ul>
      {% endif %}
    </div>
  </div>
</section>

{#- ───────────── 3. 포트폴리오 ───────────── #}
<section class="page">
  {{ sec("포트폴리오 현황", "Portfolio") }}
  {% if m.analyst %}
  <div class="comment"><div class="tag">Analyst Comment · 사실 검증 통과분만 수록</div>
    <div class="comment-body">
    {% for s in m.analyst[:4] %}<div><h4>{{ s.title }}</h4>{% for p in s.points[:2] %}<p>{{ p }}</p>{% endfor %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}
  <div class="grid2">
    <div>{{ figure(f.allocation, "보유 비중", "브로커 스냅샷(평가액 기준)") }}</div>
    <div>{{ figure(f.returns, "종목별 평가손익률", "브로커 스냅샷") }}</div>
  </div>
  {% if m.portfolio.holdings %}
  <div class="tbl">{{ tcap("보유 종목 요약 (비중 순)") }}
    <table><thead><tr><th class="l">종목</th><th>비중</th><th>현재가</th><th>1D</th><th>5D</th><th>1M</th><th>평가손익</th><th>재무</th><th class="c">신호</th><th class="l">판단</th><th class="l">오늘 액션</th></tr></thead><tbody>
    {% for h in m.portfolio.holdings %}
      <tr><td class="name">{{ h.ticker }}<small>{{ h.name | truncate(15, true, "…") }}</small></td>
      <td>{{ h.weight | num(1) }}%</td><td class="strong">${{ h.price | num(2) }}</td>
      {{ heat(h.d1, 3) }}{{ heat(h.d5, 6) }}{{ heat(h.m1, 12) }}{{ heat(h.ret_pct, 25) }}
      <td>{% if h.score is not none %}{{ h.score | num(0) }} <span class="flat">{{ h.grade }}</span>{% else %}<span class="flat">{{ h.grade }}</span>{% endif %}</td>
      <td class="c"><span class="badge line {{ h.tone }}">{{ h.signal_label }}</span></td>
      <td class="l strong nowrap">{{ h.action }}</td><td class="wrap">{{ h.today_action }}</td></tr>
    {% endfor %}
    </tbody></table>
    <div class="src">자료: 브로커 스냅샷, Yahoo Finance, 자체 규칙 · 재무 점수는 개별주만(ETF 제외)</div>
  </div>
  {% endif %}
</section>

{#- ───────────── 4. 종목별 ───────────── #}
{% if m.portfolio.holdings %}
<section class="page">
  {{ sec("종목별 점검", "Holdings") }}
  {% for h in m.portfolio.holdings %}
  <article class="stock">
    <div class="stock-head">
      <span class="tk">{{ h.ticker }}</span><span class="nm">{{ h.name }}</span>
      <span class="badge {{ h.tone }}">{{ h.action }}</span><span class="badge line {{ h.tone }}">{{ h.signal_label }}</span>
      {% if h.earnings_days is not none and 0 <= h.earnings_days <= 14 %}<span class="badge line warn">실적 D-{{ h.earnings_days | num(0) }}</span>{% endif %}
      <span class="meta">비중 <b>{{ h.weight | num(1) }}%</b> · 평가손익 <b>{{ chg(h.ret_pct, 1) }}</b></span>
    </div>
    {% if h.today_action or h.one_line %}<p class="one">{% if h.today_action %}<b>{{ h.today_action }}</b>{% endif %}{% if h.today_action and h.one_line %} — {% endif %}{{ h.one_line }}</p>{% endif %}
    <div class="stock-body">
      <div>{% if f.stocks[h.ticker] %}<img src="{{ f.stocks[h.ticker] }}" alt="{{ h.ticker }} 6개월 주가">{% else %}<div class="nochart">가격 이력 없음</div>{% endif %}</div>
      <table class="kv">
        <tr><td>현재가</td><td>${{ h.price | num(2) }}</td></tr>
        <tr><td>1D / 5D / 1M</td><td class="nowrap">{{ chg(h.d1, 1) }} / {{ chg(h.d5, 1) }} / {{ chg(h.m1, 1) }}</td></tr>
        {% if h.pos52 is not none %}<tr><td>52주 범위</td><td><span class="range"><i style="left: {{ h.pos52 }}%"></i></span></td></tr>{% endif %}
        {% if h.avg_price %}<tr><td>평균단가</td><td>${{ h.avg_price | num(2) }}</td></tr>{% endif %}
        {% if h.rsi is not none %}<tr><td>RSI(14)</td><td>{{ h.rsi | num(1) }}</td></tr>{% endif %}
        {% if h.per or h.fwd_pe %}<tr><td>PER / 선행</td><td>{{ h.per | mult }} / {{ h.fwd_pe | mult }}</td></tr>{% endif %}
        {% if h.is_fund and h.role %}<tr><td>포트 역할</td><td>{{ h.role }}</td></tr>{% endif %}
        {% if h.roe_pct is not none %}<tr><td>ROE</td><td>{{ h.roe_pct | num(1) }}%</td></tr>{% endif %}
        {% if h.target_upside is not none %}<tr><td>목표가 괴리</td><td>{{ chg(h.target_upside, 0) }}</td></tr>{% endif %}
        {% if h.next_earnings %}<tr><td>다음 실적</td><td>{{ h.next_earnings }}</td></tr>{% endif %}
        {% if h.confidence is not none %}<tr><td>판단 신뢰도</td><td><span class="meter"><i style="width: {{ h.confidence }}%"></i></span>{{ h.confidence | num(0) }}</td></tr>{% endif %}
      </table>
      <div>
        {% if h.reasons %}<h4>투자 포인트</h4><ul class="pts">{% for r in h.reasons %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
        {% if h.risks %}<h4>리스크</h4><ul class="pts risk">{% for r in h.risks %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
        {% if h.triggers %}<h4>체크포인트</h4><ul class="pts check">{% for r in h.triggers %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
        {% if h.fund_compare %}
        <h4>기간 수익률과 비교 ETF 대비 (총수익, %p)</h4>
        <table class="mini"><thead><tr><th class="l">기간</th><th>{{ h.ticker }}</th>{% for p in h.fund_compare.peers %}<th>vs {{ p }}</th>{% endfor %}</tr></thead><tbody>
        {% for r in h.fund_compare.rows %}<tr><td class="l">{{ r.label }}</td><td>{{ chg(r.ret, 1) }}</td>{% for d in r.diffs %}<td>{% if d is none %}–{% else %}<span class="{{ d | tone }}">{{ "%+.1f" | format(d) }}</span>{% endif %}</td>{% endfor %}</tr>{% endfor %}
        </tbody></table>
        {% endif %}
        {% if h.pillars %}<div class="pillars">{% for p in h.pillars %}<span>{{ p.label }}<b>{{ p.status }}</b></span>{% endfor %}</div>{% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
  <div class="src">자료: Yahoo Finance(주가·이동평균·거래량, 6개월), 브로커 스냅샷(비중·평균단가), 자체 규칙(판단·신뢰도). 점선은 평균단가.</div>
</section>
{% endif %}

{#- ───────────── 5. 스크리닝 ───────────── #}
{% if m.screens.nasdaq_buy or m.screens.kospi_buy or m.accumulation %}
<section class="page">
  {{ sec("유니버스 스크리닝", "Screening") }}
  <div class="grid2">
    <div>{{ scan(m.screens.nasdaq_buy, "NASDAQ 100 매수 후보 상위") }}</div>
    <div>{{ scan(m.screens.nasdaq_warn, "NASDAQ 100 주의 종목") }}</div>
  </div>
  <div class="grid2">
    <div>{{ scan(m.screens.kospi_buy, "KOSPI 상위 30 매수 후보") }}</div>
    <div>{{ scan(m.screens.kospi_warn, "KOSPI 상위 30 주의 종목") }}</div>
  </div>
  <div class="grid2">
    <div>{{ figure(f.scores, "NASDAQ 100 재무 점수 분포 (종목 수)", "자체 재무 점수(0~100)") }}</div>
    <div>{{ figure(f.accumulation, "기관 매집 강도 상위 (0~100)", "거래량 지표(OBV·CMF)·13F 기반 추정") }}</div>
  </div>
  {% if m.accumulation %}
  <div class="tbl">{{ tcap("기관 매집 추정 종목") }}
    <table><thead><tr><th class="l">종목</th><th class="c">판정</th><th>강도</th><th>OBV</th><th>CMF</th><th>상승/하락 거래량</th><th>13F 분기 변동</th><th>매수/매도 기관</th></tr></thead><tbody>
    {% for a in m.accumulation %}
      <tr><td class="name">{{ a.ticker }}<small>{{ a.name | truncate(24, true, "…") }}</small></td>
      <td class="c"><span class="badge line {{ a.tone }}">{{ a.verdict }}</span></td><td class="strong">{{ a.score | num(0) }}</td>
      <td>{{ a.obv | num(2) }}</td><td>{{ a.cmf | num(2) }}</td><td>{{ a.updown | num(1) }}</td>
      <td>{% if a.inst_change is not none %}{{ chg(a.inst_change, 1) }}{% else %}–{% endif %}</td>
      <td>{% if a.buyers is not none %}{{ a.buyers }} / {{ a.sellers }}{% else %}–{% endif %}</td></tr>
    {% endfor %}
    </tbody></table>
    <div class="src">자료: 거래량 방향성 지표, 미국 13F(분기) · 직접 순매수 데이터가 아닌 추정치</div>
